# IBM Bob 2.0 Hackathon — Repo Decomposition Advisor Backend
# Environment Configuration Template
# Copy this to .env and fill in values before running

# ------------------------------------------------------------------
# IBM Bob Integration (credentials provided at hackathon start)
# ------------------------------------------------------------------
BOB_API_KEY=your_bob_api_key_here
BOB_API_URL=https://api.ibm.com/bob/v1  # update when credentials arrive

# ------------------------------------------------------------------
# Dev Mode — set to true ONLY for local frontend development
# When true: POST /analyze returns fixture data, no real analysis runs
# When false (default): real parser → bob_client → heuristic pipeline
# WARNING: Must be false on demo day
# ------------------------------------------------------------------
USE_DEV_FIXTURES=true

# ------------------------------------------------------------------
# Server Config
# ------------------------------------------------------------------
PORT=8000
